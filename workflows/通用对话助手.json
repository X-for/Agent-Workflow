{
  "workflow_id": "通用对话助手",
  "name": "通用对话助手",
  "description": "处理无需调用专业工具的日常问答、解释、写作与推理请求。",
  "nodes": [
    {
      "id": "start_node",
      "type": "START",
      "position": { "x": 80, "y": 260 },
      "output_ports": [
        { "id": "out_query", "description": "用户原始问题" }
      ]
    },
    {
      "id": "conversation_agent",
      "type": "AGENT",
      "position": { "x": 390, "y": 260 },
      "name": "通用对话助手",
      "model_name": "deepseek-chat",
      "base_url": "https://api.deepseek.com",
      "system_prompt": "你是一个可靠、清晰、友好的通用对话助手。请准确理解用户意图，直接回答问题；复杂问题先在内部梳理，再给出结构清晰的结论。不要虚构事实，不确定时明确说明。除非用户要求，否则避免冗长回答。完成回答后，只将最终回复投递到【final_answer】端口。",
      "tools": [],
      "input_ports": [
        { "id": "user_input", "name": "用户输入" }
      ],
      "output_ports": [
        { "id": "final_answer", "description": "面向用户的最终回复" }
      ]
    },
    {
      "id": "end_node",
      "type": "END",
      "position": { "x": 750, "y": 260 },
      "input_ports": [
        { "id": "in_result", "name": "最终结果" }
      ]
    }
  ],
  "connections": [
    {
      "source_node": "start_node",
      "source_port": "out_query",
      "target_node": "conversation_agent",
      "target_port": "user_input"
    },
    {
      "source_node": "conversation_agent",
      "source_port": "final_answer",
      "target_node": "end_node",
      "target_port": "in_result"
    }
  ]
}
