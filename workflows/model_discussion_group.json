{
  "workflow_id": "model_discussion_group",
  "name": "多模型方案评审组",
  "description": "将同一方案并行交给逻辑、体验和工程三个视角评审，再生成综合报告。",
  "nodes": [
    {
      "id": "start_node",
      "type": "START",
      "position": {
        "x": 50,
        "y": 300
      },
      "output_ports": [
        {
          "id": "out_query"
        }
      ]
    },
    {
      "id": "node_moderator",
      "type": "AGENT",
      "name": "方案讨论主持人",
      "model_name": "deepseek-chat",
      "base_url": "https://api.deepseek.com",
      "system_prompt": "你是方案评审主持人。提炼用户方案的目标、约束和关键决策，并将同一份完整议题同时投递到三个端口：\n- 【to_model_a】：逻辑、算法、边界条件和性能视角；\n- 【to_model_b】：用户体验、创新性和使用场景视角；\n- 【to_model_c】：工程落地、架构、维护和部署视角。\n三个端口必须全部投递，payload 应包含足够上下文，使评审者可以独立工作。不要输出未声明的端口。",
      "tools": [],
      "input_ports": [
        {
          "id": "user_input",
          "name": "用户发言"
        }
      ],
      "output_ports": [
        {
          "id": "to_model_a",
          "description": "发给模型A"
        },
        {
          "id": "to_model_b",
          "description": "发给模型B"
        },
        {
          "id": "to_model_c",
          "description": "发给模型C"
        }
      ],
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "node_model_a",
      "type": "AGENT",
      "name": "逻辑与推理模型 (DeepSeek特长)",
      "model_name": "deepseek-chat",
      "base_url": "https://api.deepseek.com",
      "system_prompt": "你是以“深度推理、逻辑严密、算法优化”为特长的模型。请针对收到的方案，从逻辑漏洞、边界条件、算法复杂度、性能瓶颈等最硬核的底层逻辑角度提出你的尖锐意见和改进建议。",
      "tools": [],
      "input_ports": [
        {
          "id": "to_model_a",
          "name": "主持人议题"
        }
      ],
      "output_ports": [
        {
          "id": "opinion_a",
          "description": "模型A意见"
        }
      ],
      "position": {
        "x": 650,
        "y": 100
      }
    },
    {
      "id": "node_model_b",
      "type": "AGENT",
      "name": "创新与体验模型 (Claude特长)",
      "model_name": "anthropic/claude-opus-4.6",
      "base_url": "https://openrouter.ai/api/v1",
      "system_prompt": "你是以“用户同理心、开阔脑洞、交互体验”为特长的模型。请针对收到的方案，跳出传统的代码思维，从用户交互(UX)、创意发散、使用场景拓展、以及文本和文档组织的优雅性等角度，提出你的独特见解。",
      "tools": [],
      "input_ports": [
        {
          "id": "to_model_b",
          "name": "主持人议题"
        }
      ],
      "output_ports": [
        {
          "id": "opinion_b",
          "description": "模型B意见"
        }
      ],
      "position": {
        "x": 650,
        "y": 300
      }
    },
    {
      "id": "node_model_c",
      "type": "AGENT",
      "name": "工程与架构模型 (GPT-4特长)",
      "model_name": "openai/gpt-5.4",
      "base_url": "https://openrouter.ai/api/v1",
      "system_prompt": "你是以“工程落地、系统架构、生态兼容”为特长的模型。请针对收到的方案，从主流技术栈选型、代码可维护性、系统可扩展性、部署运维成本等实际工程落地的角度，给出你的务实建议和替代方案对比。",
      "tools": [],
      "input_ports": [
        {
          "id": "to_model_c",
          "name": "主持人议题"
        }
      ],
      "output_ports": [
        {
          "id": "opinion_c",
          "description": "模型C意见"
        }
      ],
      "position": {
        "x": 650,
        "y": 500
      }
    },
    {
      "id": "node_synthesizer",
      "type": "AGENT",
      "name": "讨论组总结员",
      "model_name": "deepseek-chat",
      "base_url": "https://api.deepseek.com",
      "system_prompt": "你是多模型评审总结员。等待并综合实际收到的独立意见，区分共识、分歧、关键风险和可执行改进项；不要把缺失输入描述成已发生的评审。输出结构清晰的 Markdown《多模型综合评审报告》，最后给出按优先级排序的修改建议。最终报告只投递到【final_report】端口。",
      "tools": [],
      "input_ports": [
        {
          "id": "opinion_a",
          "name": "模型A意见"
        },
        {
          "id": "opinion_b",
          "name": "模型B意见"
        },
        {
          "id": "opinion_c",
          "name": "模型C意见"
        }
      ],
      "output_ports": [
        {
          "id": "final_report",
          "description": "最终总结报告"
        }
      ],
      "position": {
        "x": 1050,
        "y": 300
      }
    },
    {
      "id": "end_node",
      "type": "END",
      "position": {
        "x": 1350,
        "y": 300
      },
      "input_ports": [
        {
          "id": "in_result"
        }
      ]
    }
  ],
  "connections": [
    {
      "source_node": "start_node",
      "source_port": "out_query",
      "target_node": "node_moderator",
      "target_port": "user_input"
    },
    {
      "source_node": "node_moderator",
      "source_port": "to_model_a",
      "target_node": "node_model_a",
      "target_port": "to_model_a"
    },
    {
      "source_node": "node_moderator",
      "source_port": "to_model_b",
      "target_node": "node_model_b",
      "target_port": "to_model_b"
    },
    {
      "source_node": "node_moderator",
      "source_port": "to_model_c",
      "target_node": "node_model_c",
      "target_port": "to_model_c"
    },
    {
      "source_node": "node_model_a",
      "source_port": "opinion_a",
      "target_node": "node_synthesizer",
      "target_port": "opinion_a"
    },
    {
      "source_node": "node_model_b",
      "source_port": "opinion_b",
      "target_node": "node_synthesizer",
      "target_port": "opinion_b"
    },
    {
      "source_node": "node_model_c",
      "source_port": "opinion_c",
      "target_node": "node_synthesizer",
      "target_port": "opinion_c"
    },
    {
      "source_node": "node_synthesizer",
      "source_port": "final_report",
      "target_node": "end_node",
      "target_port": "in_result"
    }
  ]
}
